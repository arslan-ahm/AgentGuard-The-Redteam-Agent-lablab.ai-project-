# SITE_ADDRESS=":80" locally (plain HTTP); on the Vultr VM set it to the public domain,
# e.g. "agentguard.example.com", and Caddy obtains and renews the HTTPS certificate itself.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		# flush_interval -1 keeps the SSE progress stream (/scans/{id}/events) unbuffered
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle /healthz {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
