#!/bin/sh
# AgentGuard: never push to main. Push a branch and open a pull request instead;
# run your area's checks locally first.
# Enable once per clone:  git config core.hooksPath .githooks
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "BLOCKED: pushing to '${remote_ref#refs/heads/}' is not allowed. Push your branch and open a PR."
      status=1
      ;;
  esac
done
exit $status
